# PostgreSQL connection string (Neon recommended for free serverless Postgres)
# Local example (Docker): postgresql://postgres:postgres@localhost:5432/pokemon_cards?schema=public
# Neon: postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"

# Long random string used to sign session JWT cookies (required)
# Generate: openssl rand -base64 32
AUTH_SECRET="change-me-in-production-use-long-random-string"

# Vercel Blob — required for photo uploads in production (serverless)
# Create a Blob store in the Vercel project dashboard; token is injected as BLOB_READ_WRITE_TOKEN
# Leave unset locally to use public/uploads on disk during `npm run dev`
# BLOB_READ_WRITE_TOKEN=""

# Optional — Pokémon TCG API key (https://docs.pokemontcg.io/).
# Works without a key, but rate limits are much lower. Sent as X-Api-Key server-side only.
# POKEMONTCG_API_KEY=""
