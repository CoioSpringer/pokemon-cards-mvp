# SQLite path is relative to the prisma/ directory
DATABASE_URL="file:./dev.db"

# Long random string used to sign session cookies
AUTH_SECRET="change-me-in-production-use-long-random-string"

# Optional — Pokémon TCG API key (https://docs.pokemontcg.io/).
# Works without a key, but rate limits are much lower. Sent as X-Api-Key server-side only.
# POKEMONTCG_API_KEY=""
